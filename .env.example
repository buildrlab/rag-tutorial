# Offline lab: no model downloads, no API calls, lexical vectors + quoted evidence.
RAG_PROVIDER=offline
RAG_PORT=8000
# Hosted mode: set RAG_PROVIDER=openai, a key, and an available generation model.
# Documents and queries will be sent to OpenAI when you run retrieval in that mode.
OPENAI_API_KEY=
EMBEDDING_MODEL=
GENERATION_MODEL=
